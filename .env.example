# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sécurité API (générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
REPORTS_API_KEY=

# CORS : URL(s) de l'app déployée, séparées par des virgules
CORS_ORIGIN=

# Divers
PING_MESSAGE=ping pong

# --- Connexion (table Supabase `rapport_users`, voir supabase/AUTH.sql) ---
# Secret de signature des sessions (OBLIGATOIRE, 30 jours).
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Application Android / domaine séparé ---
# Sur le web, laisser vide (même origine). Dans l'APK, mettre l'URL Netlify :
# VITE_API_BASE_URL=https://votre-site.netlify.app
VITE_API_BASE_URL=
